{
  "name": "aksesara-extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && mkdir -p dist-extension && cp -r .output/chrome-mv3/* dist-extension/",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aksesara/form-parser": "workspace:*",
    "@aksesara/form-schema": "workspace:*",
    "@aksesara/sync-engine": "workspace:*",
    "@aksesara/ui": "workspace:*",
    "lucide-react": "^0.330.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wxt": "^0.17.2"
  }
}


